---
import Layout from '../layouts/Layout.astro';
import SvgSprite from '../components/SvgSprite.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import Showreel from '../components/Showreel.astro';
import Manifesto from '../components/Manifesto.astro';
import Services from '../components/Services.astro';
import AllServices from '../components/AllServices.astro';
import Projects from '../components/Projects.astro';
import Method from '../components/Method.astro';
import FaqContact from '../components/FaqContact.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
---
<Layout>
  <SvgSprite />
  <Nav />
  <main id="top">
    <Hero />
    <Stats />
    <Showreel />
    <Manifesto />
    <Services />
    <AllServices />
    <Projects />
    <Method />
    <FaqContact />
    <CtaBand />
  </main>
  <Footer />
</Layout>
