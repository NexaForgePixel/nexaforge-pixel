<script>
  // Spotlight follows the pointer over the hero background
  (function(){
    const h=document.querySelector<HTMLElement>('.hero'),bg=document.querySelector<HTMLElement>('.hero-bg');if(!h||!bg)return;
    h.addEventListener('pointermove',e=>{const r=h.getBoundingClientRect();bg.style.setProperty('--mx',(e.clientX-r.left)+'px');bg.style.setProperty('--my',(e.clientY-r.top)+'px');});
  })();
</script>
