<script>
  // Light / dark theme toggle (initial theme is applied inline in <head> to avoid a flash)
  (function(){
    const root=document.documentElement,btn=document.getElementById('theme');if(!btn)return;
    const sync=()=>btn.setAttribute('aria-label',root.getAttribute('data-theme')==='light'?'Passer en mode sombre':'Passer en mode clair');
    sync();
    btn.addEventListener('click',()=>{const t=root.getAttribute('data-theme')==='light'?'dark':'light';root.setAttribute('data-theme',t);try{localStorage.setItem('nf-theme',t)}catch(e){}sync();window.dispatchEvent(new Event('themechange'));});
  })();
</script>
