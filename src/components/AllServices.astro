---
import { allServices } from '../data/site';
---
<section class="blk" id="tous-services" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head">
      <div><div class="mono">Tous nos services</div><h2>Tout votre digital au même endroit<span class="sq"></span></h2></div>
      <p>Choisissez un service ou combinez-les.</p>
    </div>
    <div class="svc-list">
      {allServices.map((s) => (
        <a class="srow" href="#contact"><span class="n">{s.n}</span><h4>{s.title}</h4><div><p>{s.text}</p><span class="tg">{s.tags}</span></div><span class="go"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
      ))}
    </div>
  </div>
</section>
